---
import { Terminal, ShieldCheck, Zap, Code2, ArrowRight } from '@lucide/vue'
---

<section class="relative overflow-hidden pt-12 pb-16 md:pt-20 md:pb-24 border-b border-zinc-200 dark:border-zinc-800">
  <div class="max-w-5xl mx-auto px-4 sm:px-6 text-center">
    <!-- 顶部小徽章 -->
    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-50 dark:bg-emerald-950/60 border border-emerald-200 dark:border-emerald-900/60 text-xs font-medium text-emerald-700 dark:text-emerald-300 mb-6">
      <span class="flex h-2 w-2 rounded-full bg-emerald-500"></span>
      <span>100% 浏览器本地运算 · 保护数据隐私</span>
    </div>

    <!-- 主标与副标 -->
    <h1 class="text-4xl sm:text-5xl md:text-6xl font-extrabold tracking-tight text-zinc-900 dark:text-zinc-50 leading-[1.15]">
      现代、简约、本地优先的 <br class="hidden sm:inline" />
      <span class="bg-gradient-to-r from-emerald-600 via-teal-600 to-emerald-500 bg-clip-text text-transparent">
        开发者实用工具箱
      </span>
    </h1>

    <p class="mt-6 text-base sm:text-lg text-zinc-600 dark:text-zinc-400 max-w-2xl mx-auto leading-relaxed">
      无需安装、零网络依赖、所有计算均在浏览器本地安全完成。提供格式化与压缩、语法校验与错误定位、大型
      JSON 树形检索、JSONPath 提取、多格式互转与 TS/Java/Go
      代码模型推导等高频工具，助你高效解决日常开发任务。
    </p>

    <!-- 行动按钮 -->
    <div class="mt-8 flex flex-wrap items-center justify-center gap-4">
      <a
        href="/json-formatter"
        class="inline-flex items-center gap-2 px-6 py-3 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white font-medium text-sm transition-[background-color,box-shadow] shadow-md shadow-emerald-500/20 hover:shadow-lg hover:shadow-emerald-500/30 cursor-pointer"
      >
        <span>进入工具工作台</span>
        <ArrowRight class="w-4 h-4" />
      </a>

      <a
        href="#tools-section"
        class="inline-flex items-center gap-2 px-5 py-3 rounded-xl bg-white dark:bg-zinc-900 hover:bg-zinc-50 dark:hover:bg-zinc-800 border border-zinc-200 dark:border-zinc-800 text-zinc-800 dark:text-zinc-200 font-medium text-sm transition-colors cursor-pointer"
      >
        浏览所有工具
      </a>
    </div>

    <!-- 核心特性标签 -->
    <div class="mt-12 grid grid-cols-2 sm:grid-cols-4 gap-4 pt-8 border-t border-zinc-100 dark:border-zinc-800/60 max-w-3xl mx-auto text-left">
      <div class="flex items-start gap-2.5">
        <ShieldCheck class="w-5 h-5 text-emerald-500 shrink-0 mt-0.5" />
        <div>
          <div class="text-xs font-semibold text-zinc-900 dark:text-zinc-100">100% 本地运算</div>
          <div class="text-[11px] text-zinc-400">数据绝不离机上传</div>
        </div>
      </div>

      <div class="flex items-start gap-2.5">
        <Terminal class="w-5 h-5 text-emerald-500 shrink-0 mt-0.5" />
        <div>
          <div class="text-xs font-semibold text-zinc-900 dark:text-zinc-100">自由双栏工作台</div>
          <div class="text-[11px] text-zinc-400">左侧导航右侧沉浸操作</div>
        </div>
      </div>

      <div class="flex items-start gap-2.5">
        <Zap class="w-5 h-5 text-amber-500 shrink-0 mt-0.5" />
        <div>
          <div class="text-xs font-semibold text-zinc-900 dark:text-zinc-100">智能容错修复</div>
          <div class="text-[11px] text-zinc-400">自动补全引号与尾逗号</div>
        </div>
      </div>

      <div class="flex items-start gap-2.5">
        <Code2 class="w-5 h-5 text-teal-500 shrink-0 mt-0.5" />
        <div>
          <div class="text-xs font-semibold text-zinc-900 dark:text-zinc-100">代码类型生成</div>
          <div class="text-[11px] text-zinc-400">一键导出 TS / Java / Go</div>
        </div>
      </div>
    </div>
  </div>
</section>
