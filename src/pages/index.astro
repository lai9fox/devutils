---
import BaseLayout from '../layouts/BaseLayout.astro'
import Hero from '../components/home/Hero.astro'
import ToolGrid from '../components/home/ToolGrid.vue'
---

<BaseLayout
  title="DevUtils - 现代、简约、本地优先的开发者实用工具箱"
  description="专为现代开发者打造的本地优先实用工具箱，提供 JSON 格式化与压缩、语法校验与错误定位、大型 JSON 树形检索、JSONPath 提取、多格式互转与 TS/Java/Go 代码模型推导等高频工具，本地运算、保护隐私。"
>
  <!-- 落地页 Hero -->
  <Hero />

  <!-- 工具列表与筛选 -->
  <ToolGrid client:load />
</BaseLayout>
